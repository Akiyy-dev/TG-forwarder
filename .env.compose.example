# Release images. Keep latest, or pin IMAGE_TAG to a release tag such as v1.2.3.
APP_IMAGE=ghcr.io/akiyy-dev/tg-forwarder
SAFEW_IMAGE=ghcr.io/akiyy-dev/tg-forwarder-safew
IMAGE_TAG=latest

# This value is embedded in a URL; use a long URL-safe alphanumeric value.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
WEB_SECRET_KEY=replace-with-a-long-random-secret
WEB_ADMIN_USERNAME=admin
# Generate with: python -m scripts.hash_password
# Keep the generated single quotes because Argon2 hashes contain '$'.
WEB_ADMIN_PASSWORD_HASH=
WEB_SECURE_COOKIES=false

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
SOURCE_CHANNELS=@source_channel
BOT_TOKEN=
# Required only when BOT_POLLING_ENABLED=true.
BOT_ADMIN_IDS=
# Disable only getUpdates/admin commands; outbound Telegram publishing remains active.
BOT_POLLING_ENABLED=true
TARGET_CHANNEL_ID=

NOVNC_PASSWORD=replace-with-a-strong-password
NOVNC_PORT=6080
WEB_PORT=8000

# SafeW application filter and optional exact conversation-title allowlist.
SAFEW_APP_NAMES=SafeW
SAFEW_ALLOWED_CHATS=
SAFEW_CAPTURE_ALL_APPS=false
SAFEW_AUTO_REGISTER_SOURCES=true
LOG_LEVEL=INFO

APP_ENV=production
LOG_LEVEL=INFO

TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+10000000000
TELEGRAM_SESSION_PATH=./data/sessions/listener

BOT_TOKEN=123456:ABC-DEF_your_bot_token
BOT_ADMIN_IDS=123456789
TARGET_CHANNEL_ID=-1001234567890

SOURCE_CHANNELS=@example_channel,-1009876543210
DATABASE_URL=sqlite+aiosqlite:///./data/database/app.db

DOWNLOAD_DIR=./data/downloads
MAX_DOWNLOAD_SIZE_MB=100
TEMP_FILE_TTL_MINUTES=60

ALBUM_WAIT_SECONDS=2.5
ALBUM_MAX_WAIT_SECONDS=20.0
QUEUE_MAXSIZE=1000
MAX_CONCURRENCY=3

ENABLE_KEYWORD_FILTER=true
ENABLE_TEXT_REPLACE=true
ENABLE_LINK_FILTER=true
ENABLE_FOOTER=true
ENABLE_DUPLICATE_FILTER=true

BLOCKED_KEYWORDS=
ALLOWED_KEYWORDS=
KEYWORD_CASE_SENSITIVE=false
ALLOW_EMPTY_TEXT=true

TEXT_REPLACEMENTS=
REMOVE_SOURCE_LINKS=true
REMOVE_ALL_LINKS=false
REMOVE_TELEGRAM_INVITES=true
BLOCKED_LINK_DOMAINS=
ALLOWED_LINK_DOMAINS=
MESSAGE_FOOTER=

DUPLICATE_CONTENT_WINDOW_HOURS=24

MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2

# Web admin panel
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_ADMIN_USERNAME=admin
# Generate hash via: python -m scripts.create_admin
WEB_ADMIN_PASSWORD_HASH=
WEB_SECRET_KEY=change-me-to-a-long-random-string
WEB_ACCESS_TOKEN_EXPIRE_MINUTES=60
WEB_REFRESH_TOKEN_EXPIRE_DAYS=7
WEB_ALLOWED_ORIGINS=http://localhost:5173
WEB_SECURE_COOKIES=false
WEB_TRUST_PROXY=false
WEB_DOCS_ENABLED=true
WEB_LOGIN_RATE_LIMIT=10
WEB_LOGIN_RATE_WINDOW_SECONDS=60
